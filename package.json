  "devDependencies": {
    "@anthropic-ai/claude-code": "^2.1.263",
    "@trunkio/launcher": "^1.3.4",
    "@types/node": "^26.4.1",
    "drizzle-kit": "^0.31.10",
    "nitro-cloudflare-dev": "^0.2.2",
    "nitropack": "^2.13.4",
