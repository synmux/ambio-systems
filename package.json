    "@tailwindcss/vite": "^4.3.3",
    "@types/three": "^0.185.4",
    "@unhead/vue": "^3.4.0",
    "daisyui": "^5.7.28",
    "drizzle-orm": "^0.45.2",
    "eslint": "^10.10.0",
    "nuxt": "^4.5.2",
    "tailwindcss": "^4.3.3",
    "three": "^0.185.1",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@anthropic-ai/claude-code": "^2.1.263",
    "@trunkio/launcher": "^1.3.4",
    "@types/node": "^26.4.1",
    "drizzle-kit": "^0.31.10",
    "nitro-cloudflare-dev": "^0.2.2",
    "nitropack": "^2.13.4",
    "node-gyp": "^13.0.2",
    "npm-run-all2": "^9.0.3",
    "prettier": "^3.9.6",
    "skilld": "^2.3.0",
    "wrangler": "^4.129.0"
  },
  "name": "ambio",
  "private": true,
  "scripts": {
    "build": "pnpm nuxt build",
    "cf-typegen": "pnpm wrangler types",
    "db:generate": "pnpm drizzle-kit generate",
    "db:migrate:local": "pnpm wrangler d1 migrations apply ambio-systems --local",
    "db:migrate:remote": "pnpm wrangler d1 migrations apply ambio-systems --remote",
    "db:studio": "pnpm drizzle-kit studio",
    "deploy": "pnpm run-s build deploy:wrangler",
    "deploy:wrangler": "pnpm wrangler deploy",
    "dev": "pnpm run-s build dev:wrangler",
    "dev:wrangler": "pnpm wrangler dev",
    "format": "pnpm run-s format:prettier format:trunk",
    "format:prettier": "pnpm prettier --write .",
    "format:trunk": "pnpm trunk fmt -a",
    "generate": "pnpm nuxt generate",
    "lint": "pnpm trunk check -a",
    "lint:fix": "pnpm trunk check -a --fix",
    "lint:types": "pnpm tsc --noEmit",
    "postinstall": "pnpm run-s prepare cf-typegen format",
    "prepare": "pnpm nuxt prepare && (skilld prepare || true)"
  },
  "type": "module",
  "packageManager": "pnpm@12.4.1+sha512.2e81e399d73fe8390dab25e06aa788ab7a5908248d2f5a370f82b481147a6a7a367bf8048f9a6fdb6460f21a66f0542dedb8b94ca2c8723596741920b1656d4c",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/synmux/ambio-systems.git"
  },
  "version": "0.0.0-dev.0"
}
